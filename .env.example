# ============================================
# 24Hr Service — Automated Test Configuration
# ============================================
# Copy this file to .env and fill in real values
#
# Targets the two cloned repos:
#   24hr-New-UI (Next.js on port 4000)
#   24hourservice-Backend (Express on port 3000)

# ─── Local Dev URLs ─────────────────────────────────────
BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:3000

# ─── Production/Staging URLs (for remote runs) ──────────
# BASE_URL=https://dev.24hrtruckfix.com
# API_BASE_URL=https://two4hourservice-backend-1nt5.onrender.com

# ─── Test Accounts — Admin ──────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ─── Test Accounts — Dispatcher ─────────────────────────
DISPATCHER_EMAIL=dispatcher@example.com
DISPATCHER_PASSWORD=your_dispatcher_password

# ─── Test Accounts — Client ─────────────────────────────
CLIENT_EMAIL=client@example.com
CLIENT_PASSWORD=your_client_password

# ─── Test Accounts — View Only ──────────────────────────
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=your_viewer_password

# ─── 2FA Test Code (for dev/staging only) ───────────────
TEST_2FA_CODE=123456

# ─── Timeouts (ms) ──────────────────────────────────────
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
